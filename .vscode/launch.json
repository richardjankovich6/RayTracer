{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++ Debug: Launch with GDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/RayTracer",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "debug RayTracer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/RayTracer",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": false,
            "args": [],
            "externalConsole": false,
            "cwd": "${workspaceRoot}/build",

            // "preLaunchTask": "c++: build active file",
            "preLaunchTask": "Build Debug RayTracer",
            "internalConsoleOptions": "openOnSessionStart",

            // "setupCommands": [
            //     {
                    // "description": "Enable skipping built-in libraries when single stepping code",
                    // "text": "-interpreter-exec console \"skip -gfi /usr/include/c++/26/bits/*.h\"",
                    // "ignoreFailures": true
            //     }
            // ]
        },
        {
            "name": "run RayTracer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/RayTracer",
            "args": [],
            "cwd": "${workspaceRoot}/build",
            "preLaunchTask": "Build Release RayTracer",
        }
    ]
}