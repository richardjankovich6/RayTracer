{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Release RayTracer",
            "type": "shell",
            "command": "cmake --build build --config release",
            "group": {
                "kind" : "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Debug RayTracer",
            "type": "shell",
            "command": "cmake --build build --config Debug",
            "group": {
                "kind" : "build",
                "isDefault": true
            }
        },
        {
            "label": "clean Debug RayTracer",
            "type": "shell",
            "command": "cmake --build . --target clean",
            "group": {
                "kind" : "build",
                "isDefault": true
            }
        },
        {
            "label": "c++: build active file",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build"],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }

    ]
}